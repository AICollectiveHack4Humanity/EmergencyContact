GEMINI_API_KEY=
# Rolling free Flash alias by default (survives model retirements).
# Pin a version with GEMINI_MODEL=gemini-3.6-flash if you prefer.
GEMINI_MODEL=gemini-flash-latest
PHOTON_ENABLED=false
# Photon Spectrum credentials (dashboard Settings). PHOTON_* aliases accepted.
# Cloud auto-discovery is used: no per-line tokens needed.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Public base URL for session links texted back to users.
HAVEN_PUBLIC_URL=https://haven-eight-sigma.vercel.app
FALKORDB_ENABLED=false
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=haven
# Hosted alternative (FalkorDB Cloud): set the full URL instead of host/port.
# FALKORDB_URL=falkors://user:pass@host:port
CONTACT_1_NAME=Priya
CONTACT_1_PHONE=+15555550101
CONTACT_2_NAME=Jordan
CONTACT_2_PHONE=+15555550102
# Demo: point CONTACT_*_PHONE at the test phone in E.164 (+19252370259) to receive real texts.
NEXT_PUBLIC_DEMO_PIN=2580
